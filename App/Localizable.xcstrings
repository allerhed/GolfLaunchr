    "privacy.delete.keeps": {
      "comment": "What deletion does not affect",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not affected: your App Store purchases and subscription (Apple manages those) and the count of free shots you have used, which is kept so that deleting data cannot reset the free allowance."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Påverkas inte: dina köp och din prenumeration i App Store (Apple hanterar dem) och antalet gratis slag du har använt, som sparas så att radering av data inte kan återställa gratisslagen."
          }
        }
      }
    },
    "privacy.delete.removes": {
