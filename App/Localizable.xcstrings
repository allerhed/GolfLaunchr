        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange loften som ett tal."
          }
        }
      }
    },
    "clubEdit.error.loftOutOfRange": {
      "comment": "Validation: loft out of range",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loft must be between 1° and 70°."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Loften måste vara mellan 1° och 70°."
          }
        }
      }
    },
    "clubEdit.error.nameTooLong": {
      "comment": "Validation: name too long",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name can be at most 40 characters."
