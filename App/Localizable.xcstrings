        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mörkt"
          }
        }
      }
    },
    "appearance.light": {
      "comment": "Theme option: light",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljust"
          }
        }
      }
    },
    "appearance.system": {
      "comment": "Theme option: follow the system",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "System"
          }
        }
      }
    },
    "bag.add": {
      "comment": "Button and VoiceOver label: add a club",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add club"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till klubba"
          }
        }
      }
    },
    "bag.archive": {
      "comment": "Swipe action: archive a club (kept for history, not deleted)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archive"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkivera"
          }
        }
      }
    },
    "bag.archived": {
      "comment": "Section: clubs the golfer has archived",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archived"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkiverade"
          }
        }
      }
    },
    "bag.empty": {
      "comment": "Empty state when there are no active clubs",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No clubs in your bag. Tap + to add one."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga klubbor i bagen. Tryck på + för att lägga till."
          }
        }
      }
    },
    "bag.loadError": {
      "comment": "Error shown when the stored bag cannot be read",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your bag could not be loaded. Your saved data has not been changed."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagen kunde inte läsas in. Din sparade data har inte ändrats."
          }
        }
      }
    },
    "bag.restore": {
      "comment": "Swipe action: bring an archived club back",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställ"
          }
        }
      }
    },
    "bag.saveError": {
      "comment": "Error shown when saving the bag failed",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change could not be saved. Nothing was changed."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändringen kunde inte sparas. Inget ändrades."
          }
        }
      }
    },
    "bag.title": {
      "comment": "Screen title: the golfer's clubs",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My Bag"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Min bag"
          }
        }
      }
    },
    "capability.experimental": {
      "comment": "Device status",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimentell"
          }
        }
      }
    },
    "capability.experimental.explain": {
      "comment": "Explains Experimental",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone has not been validated yet, so results may be less accurate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här iPhonen har inte validerats än, så resultaten kan vara mindre exakta."
          }
        }
      }
    },
    "capability.reason.belowValidatedFrameRate": {
      "comment": "Capability reason",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This camera no longer offers the speed it was validated at."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameran erbjuder inte längre den hastighet den validerades med."
          }
        }
      }
    },
    "capability.reason.noCamera": {
      "comment": "Capability reason",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No usable camera was found."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen användbar kamera hittades."
          }
        }
      }
    },
    "capability.reason.noHighFrameRate": {
      "comment": "Capability reason",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera cannot record fast enough (120 frames per second or more)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameran kan inte spela in tillräckligt snabbt (minst 120 bilder per sekund)."
          }
        }
      }
    },
    "capability.reason.noValidatedProfile": {
      "comment": "Capability reason",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone model has not been validated yet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här iPhone-modellen har inte validerats än."
          }
        }
      }
    },
    "capability.reason.osTooOld": {
      "comment": "Capability reason",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs iOS 18 or later."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kräver iOS 18 eller senare."
          }
        }
      }
    },
    "capability.reason.storageCritical": {
      "comment": "Capability reason",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Almost no free storage. Free up space first."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nästan inget ledigt lagringsutrymme. Frigör utrymme först."
          }
        }
      }
    },
    "capability.reason.storageLow": {
      "comment": "Capability reason",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Little free storage. Free up space before recording."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lite ledigt lagringsutrymme. Frigör utrymme innan du spelar in."
          }
        }
      }
    },
    "capability.supported": {
