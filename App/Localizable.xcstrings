            "state": "translated",
            "value": "Kalibrera om."
          }
        }
      }
    },
    "setup.blocker.calibrationLost.reason": {
      "comment": "Why capture is blocked",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The calibration is no longer valid."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibreringen gäller inte längre."
          }
        }
      }
    },
    "setup.blocker.cameraNotRunning.action": {
      "comment": "What to do about it",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait a moment and check that camera access is on."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vänta en stund och kontrollera att kameraåtkomst är på."
          }
        }
      }
    },
    "setup.blocker.cameraNotRunning.reason": {
      "comment": "Why capture is blocked",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is not delivering images yet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameran levererar inga bilder än."
          }
        }
      }
    },
    "setup.blocker.deviceMoving.action": {
      "comment": "What to do about it",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fix the phone on a stable tripod and keep people out of view."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fäst telefonen på ett stabilt stativ och håll personer utanför bild."
          }
        }
      }
    },
    "setup.blocker.deviceMoving.reason": {
      "comment": "Why capture is blocked",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The picture is moving."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilden rör sig."
          }
        }
      }
    },
    "setup.blocker.exposureTooLong.action": {
      "comment": "What to do about it",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add light so a faster shutter can be used."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillför ljus så att en snabbare slutartid kan användas."
          }
        }
      }
    },
    "setup.blocker.exposureTooLong.reason": {
      "comment": "Why capture is blocked",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shutter is too slow for sharp shots."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slutartiden är för lång för skarpa slag."
          }
        }
      }
    },
    "setup.blocker.flickerLikely.action": {
      "comment": "What to do about it",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to steady light, such as daylight or a flicker-free lamp."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byt till jämnt ljus, till exempel dagsljus eller en flimmerfri lampa."
          }
        }
      }
    },
    "setup.blocker.flickerLikely.reason": {
      "comment": "Why capture is blocked",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The light flickers."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljuset flimrar."
          }
        }
      }
    },
    "setup.blocker.handednessMissing.action": {
      "comment": "What to do about it",
